rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isConnected(userId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/connections/$(userId)) ||
        exists(/databases/$(database)/documents/users/$(userId)/connections/$(request.auth.uid))
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /connections/{connectionId} {
        allow read, write: if isOwner(userId);
        allow create, update: if signedIn()
          && connectionId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(request.auth.uid));
        allow delete: if signedIn() && connectionId == request.auth.uid;
      }

      match /pushSubscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isConnected(userId);
        allow write: if isOwner(userId);
      }

      match /alerts/{alertId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && isConnected(userId);
      }
    }

    match /connectCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'connectionCode', 'updatedAt']);
      allow delete: if signedIn() && resource != null && resource.data.uid == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      allow read: if false;
      allow create, update, delete: if isOwner(userId);
    }
  }
}
